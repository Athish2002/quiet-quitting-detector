{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quiet-quitting-detector",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "design-mockups",
      "runtimeExecutable": "D:/Python/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5050",
        "--directory",
        "design/design_handoff_qq_ui"
      ],
      "port": 5050
    }
  ]
}
