# Quiet-Quitting Detector -- Environment Variables
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# Every variable below is parsed and CHECKED at startup by src/config.py. A bad
# value is a refusal to boot with an explanation, not a silent fall back to the
# default -- a typo you cannot distinguish from "unset" is the expensive kind.
# The rules it enforces:
#
#   ALLOW_ORIGINS           no "*", and every origin needs an http(s):// scheme
#   API_KEYS                valid JSON; role in viewer|manager|admin;
#                           key_sha256 a 64-character hex digest (the HASH,
#                           not the key -- pasting the key authenticates nobody)
#   IDENTITY_SALT           at least 16 characters if set at all
#   WEBHOOK_SIGNING_SECRET  at least 16 characters if set at all
#   any *_PATH / *_DIR      not empty; unset it to use the default instead

# ---------------------------------------------------------------------------
# Required: Gemini API key (used by all 5 agents + the NL metric extractor)
# Get a free key at: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# Some ADK internals look for GOOGLE_API_KEY specifically -- keep both in
# sync unless you're using Vertex AI (see below).
GOOGLE_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Optional: extra LLM providers in the fallback chain, so a Gemini rate-limit
# is no longer a hurdle. The chain is: Gemini -> Groq -> local Ollama -> the
# built-in local ML fallback. Each rung activates only if configured below;
# with none set, behaviour is Gemini-only exactly as before.
#
# Groq -- free, fast, OpenAI-compatible. Get a key at https://console.groq.com
# (litellm reads GROQ_API_KEY automatically). GROQ_MODELS is optional.
# ---------------------------------------------------------------------------
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODELS=groq/llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Ollama -- fully local, no key, no rate limit, no data leaves the machine.
# Install from https://ollama.com, run `ollama pull llama3.2`, then set the
# model id below (leave OLLAMA_MODEL blank to keep Ollama disabled).
# ---------------------------------------------------------------------------
# OLLAMA_MODEL=ollama_chat/llama3.2
# OLLAMA_API_BASE=http://localhost:11434

# ---------------------------------------------------------------------------
# Optional: CORS allow-list for the FastAPI server.
# Comma-separated origins, e.g. "https://your-tunnel.ngrok.io,http://localhost:3000"
# Defaults to http://localhost:8000 and http://localhost:5173 if unset.
# "*" is refused: CORS runs with credentials, so a wildcard would let any origin
# drive an authenticated session.
# ---------------------------------------------------------------------------
# ALLOW_ORIGINS=http://localhost:8000

# ---------------------------------------------------------------------------
# Optional: Real AWS S3 credentials for the Cloud Bucket ingestion source.
# Without these, that source transparently reads a local folder
# (data/s3_bucket/) instead -- no AWS account needed to use the app.
# Requires the optional `cloud` dependency group: `uv sync --extra cloud`
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=

# ---------------------------------------------------------------------------
# Optional: only needed if deploying via Google Cloud Vertex AI / Agent
# Engine instead of the default local Gemini API key setup above.
# ---------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# ---------------------------------------------------------------------------
# Phase 4 -- authentication (§7). Closes blocker B1.
#
# There is no "auth off" switch. If API_KEYS is unset the server generates one
# temporary admin key and prints it at startup; it changes on every restart.
# That is fine locally and is not a deployment posture -- set real keys below.
#
# Store only the SHA-256 of each key. Generate a key and its hash with:
#   python -c "import secrets,hashlib; k=secrets.token_urlsafe(32); \
#     print('key:', k); print('sha256:', hashlib.sha256(k.encode()).hexdigest())"
#
# Roles: viewer (read), manager (ingest, run, feedback), admin (everything,
# including the destructive routes).
# ---------------------------------------------------------------------------
# API_KEYS=[{"id":"dashboard","role":"viewer","key_sha256":"..."},{"id":"ops","role":"admin","key_sha256":"..."}]

# Shared secret for webhook ingest. The sender signs the raw request body:
#   X-Signature: sha256=<hmac_sha256(secret, body)>
# Unset means unsigned webhooks are rejected -- absence of a secret is not trust.
# WEBHOOK_SIGNING_SECRET=your_webhook_signing_secret_here

# ---------------------------------------------------------------------------
# Phase 3 -- feedback and model registry storage locations (optional).
# ---------------------------------------------------------------------------
# FEEDBACK_DB_PATH=data/feedback.db
# INTERVENTION_DB_PATH=data/interventions.db
# MODEL_REGISTRY_DIR=data/models
# AUDIT_DB_PATH=data/audit.db
# IDENTITY_MAP_PATH=data/identity_map.json
# API_METRICS_PATH=api_metrics.json
# DATA_ALLOWLIST_PATH=config/data_allowlist.json

# ---------------------------------------------------------------------------
# Pseudonymisation salt. Without it, surrogate IDs are reversible by brute
# force over a list of names -- i.e. not pseudonymous. Unset is allowed (and
# warned about) so the demo runs; set it before any real personal data.
# ---------------------------------------------------------------------------
# IDENTITY_SALT=
